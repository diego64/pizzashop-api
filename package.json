{
  "name": "pizzashop-api",
  "type": "module",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start:dev": "tsx watch src/http/server.ts",
    "start": "node build/http/server.js",
    "build": "tsup src --out-dir build --format esm --target es2022",
    "generate": "drizzle-kit generate:pg",
    "migrate": "dotenv -e .env -- npx drizzle-kit migrate",
    "seed": "tsx --env-file .env src/db/seed.ts",
    "envtest": "dotenv -e .env -- printenv DATABASE_URL",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "generate:coverage": "npx vitest run --coverage",
    "coverage": "npx serve coverage"
  },
  "author": "Diego Ferreira <diegoferreira1964@gmail.com>",
  "license": "GNU General Public License v3.0",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@paralleldrive/cuid2": "2.2.2",
    "@react-email/components": "^0.0.11",
    "dayjs": "^1.11.10",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "drizzle-typebox": "^0.1.1",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "^5.0.1",
    "pg-connection-string": "^2.9.0",
    "postgres": "3.4.3",
    "react": "^18.2.0",
    "remove": "^0.1.5",
    "resend": "^2.0.0",
    "zod": "^3.25.67",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@faker-js/faker": "8.3.1",
    "@rocketseat/eslint-config": "2.1.0",
    "@types/node": "^24.0.3",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.2.39",
    "@vitest/coverage-v8": "^3.2.4",
    "chalk": "5.3.0",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "8.54.0",
    "eslint_d": "13.1.1",
    "eslint-plugin-drizzle": "^0.2.1",
    "pg": "^8.16.0",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^11.0.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "5.3.2",
    "vitest": "^3.2.4"
  }
}
